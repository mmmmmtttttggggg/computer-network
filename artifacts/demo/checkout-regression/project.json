{
  "schemaVersion": 1,
  "name": "The database switch",
  "description": "A peer selector swap blocks payments and opens analytics. Reduce this regression into a tiny replayable bundle.",
  "topology": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "apps",
        "labels": {
          "team": "apps"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "data",
        "labels": {
          "team": "data"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "ops",
        "labels": {
          "team": "ops"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "frontend",
        "namespace": "apps",
        "labels": {
          "app": "frontend",
          "tier": "service"
        },
        "annotations": {
          "netscope.io/role": "workload"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "app",
            "image": "data-only/not-executed",
            "ports": [
              {
                "containerPort": 8080,
                "name": "http",
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "payments",
