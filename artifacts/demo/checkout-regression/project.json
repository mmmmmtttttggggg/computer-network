                "containerPort": 8082,
                "name": "http",
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "agent",
        "namespace": "apps",
        "labels": {
          "app": "agent",
          "tier": "service"
        },
        "annotations": {
          "netscope.io/role": "agent"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "app",
            "image": "data-only/not-executed",
            "ports": [
              {
                "containerPort": 8090,
                "name": "http",
                "protocol": "TCP"
              }
            ]
