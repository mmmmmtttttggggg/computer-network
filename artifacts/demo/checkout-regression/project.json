          "tier": "service"
        },
        "annotations": {
          "netscope.io/role": "workload"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "app",
            "image": "data-only/not-executed",
            "ports": [
              {
                "containerPort": 8080,
                "name": "http",
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
