  "queries": [
    {
      "source": "data/b",
      "destination": "apps/b",
      "protocol": "TCP",
      "port": 8080
    }
  ],
  "description": "A two-Pod DoesNotExist selector case where independent static analyzers disagree. NetScope predicts Allow; use recorded CNI observations to investigate.",
  "threatModel": {}
